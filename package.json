{
  "name": "theirside-monorepo",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "demo:seed": "pnpm --filter @theirside/collector demo:seed",
    "bench:detect": "pnpm --filter @theirside/collector bench:detect",
    "demo": "node scripts/demo.mjs up",
    "demo:logs": "node scripts/demo.mjs logs",
    "demo:stop": "node scripts/demo.mjs stop",
    "demo:reset": "node scripts/demo.mjs reset",
    "sim": "node scripts/sim.mjs serve",
    "sim:run": "node scripts/sim.mjs run",
    "sim:list": "node scripts/sim.mjs list",
    "sim:stop": "node scripts/sim.mjs stop",
    "sim:reset": "node scripts/sim.mjs reset",
    "sim:help": "pnpm --silent --filter @theirside/collector sim:help",
    "docs:generate": "pnpm --filter @theirside/docs-site generate",
    "docs:check": "pnpm --filter @theirside/docs-site check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "~4.1.12"
  }
}
