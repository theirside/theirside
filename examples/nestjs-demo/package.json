{
  "name": "@theirside/nestjs-demo",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS demo app: calls four fake providers through @nestjs/axios HttpService and fetch, instrumented by the SDK, with AWS X-Ray captureHTTPsGlobal on.",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "aws-xray-sdk-core": "^3.12.0",
    "axios": "^1.21.0",
    "@theirside/sdk": "workspace:*",
    "nestjs-cls": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
