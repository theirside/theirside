{
  "name": "@theirside/sdk",
  "version": "0.1.0",
  "description": "Drop-in Node SDK that records outgoing calls to your third-party providers and tells you when one of their endpoints starts failing.",
  "license": "MIT",
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@theirside/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "keywords": [
    "monitoring",
    "third-party",
    "integrations",
    "http",
    "fetch",
    "axios",
    "observability"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "node --import tsx --conditions=@theirside/source bench/overhead.ts",
    "bench:collector-down": "node --expose-gc --import tsx --conditions=@theirside/source bench/collector-down.ts",
    "compat": "node test-compat/run.cjs",
    "prepublishOnly": "pnpm run build && vitest run && node test-compat/run.cjs"
  },
  "devDependencies": {
    "@theirside/shared": "workspace:*",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "aws-xray-sdk-core": "^3.12.0",
    "axios": "^1.21.0",
    "nock": "^14.0.17",
    "selfsigned": "^5.5.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  }
}
