# Generic image for a workspace package (tools, examples), e.g.
#   docker build -f docker/Dockerfile.node-app --build-arg PACKAGE=@theirside/chaos-provider .
FROM node:22-bookworm-slim AS build
ARG PACKAGE
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter "${PACKAGE}..." run build
RUN pnpm --filter "${PACKAGE}" deploy --prod --legacy /out

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /out /app
USER node
CMD ["npm", "start"]
