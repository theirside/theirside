# Collector image: ingest, scheduler, API, dashboard and status page in one process.
# Build from the repo root:  docker build -f docker/Dockerfile.collector -t theirside/collector .

FROM node:22-bookworm-slim AS build
# docker compose builds this only for THEIRSIDE_VERSION=local. For a release version it
# falls back to a build when the pull fails; stop that here instead of silently running
# a source build under a release tag. Plain `docker build` leaves the default.
ARG THEIRSIDE_VERSION=local
RUN [ "$THEIRSIDE_VERSION" = local ] || { echo "ERROR: ghcr.io/theirside/collector:$THEIRSIDE_VERSION could not be pulled (wrong version, no access to ghcr.io, or --build). Released versions are never built from source; set THEIRSIDE_VERSION=local to build this checkout." >&2; exit 1; }
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @theirside/collector... run build
# dashboard SPA → apps/collector/public (shipped via the package's `files`)
RUN pnpm --filter @theirside/dashboard run build
# standalone copy of the collector with production dependencies only
RUN pnpm --filter @theirside/collector deploy --prod --legacy /out

FROM node:22-bookworm-slim AS runtime
# FCL is not on the SPDX list, hence LicenseRef-; the bundled SDK/shared code is MIT (LICENSING.md)
LABEL org.opencontainers.image.licenses="LicenseRef-FCL-1.0-ALv2" \
      org.opencontainers.image.vendor="KRAVA IT SERVICES LTD"
ENV NODE_ENV=production \
    PORT=4318
WORKDIR /app
COPY --from=build --chown=node:node /out /app
COPY --from=build /repo/LICENSE /repo/LICENSING.md /app/
USER node
EXPOSE 4318
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4318)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
