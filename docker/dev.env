# Well-known values for the demo, e2e, smoke, soak and ingest-bench stacks, so the demo app,
# load generator and test tools can reach the collector without reading its log:
#   docker compose --env-file docker/dev.env -f docker/docker-compose.yml --profile demo up --build
# Public, in git, and therefore not secrets: never use this file on a host anyone else can reach.
# Without it, a fresh collector generates its own API key and logs a one-time setup link.
THEIRSIDE_BOOTSTRAP_API_KEY=tsd_live_localdemo0000000000000000
THEIRSIDE_ADMIN_TOKEN=change-me-admin-token
