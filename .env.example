# Theirside collector settings. Copy to .env (git-ignored), fill in, then:
#   docker compose --env-file .env -f docker/docker-compose.yml up -d
# Every value here is a placeholder. Never commit a filled-in copy.

# --- image ----------------------------------------------------------------
# Collector release to run: ghcr.io/theirside/collector:<version>. A release version is
# only ever pulled; if the pull fails, compose stops with an error rather than building.
# `local` (the default when unset or empty) builds the image from this checkout instead
# (add --build to rebuild after changes).
THEIRSIDE_VERSION=0.1.0

# --- required -------------------------------------------------------------
# Postgres connection (the compose file builds this from POSTGRES_PASSWORD).
# DATABASE_URL=postgres://theirside:<password>@<host>:5432/theirside
POSTGRES_PASSWORD=change-me

# First start: creates the org, admin and this project API key (tsd_live_ + at least 16 characters).
THEIRSIDE_BOOTSTRAP_API_KEY=tsd_live_change-me-32-random-characters
# Creates the first dashboard account on the setup page (or use the setup code the
# collector prints to its log), then break-glass sign-in. Generate: openssl rand -hex 24
THEIRSIDE_ADMIN_TOKEN=change-me
# Encrypts two-factor (TOTP) secrets; required for 2FA. At least 32 characters:
# openssl rand -base64 32. Back it up: without it, 2FA codes can't be checked.
# To rotate, move the old key to THEIRSIDE_SECRET_KEY_PREVIOUS and restart.
THEIRSIDE_SECRET_KEY=
# THEIRSIDE_SECRET_KEY_PREVIOUS=

# --- links ---------------------------------------------------------------
# Where people open the dashboard (private network). Used for "Open in dashboard"
# links in alerts; when unset, alerts carry no link rather than a localhost one.
THEIRSIDE_PUBLIC_URL=https://theirside.internal.example.com

# --- sign-in (optional; docs/security.md) ---------------------------------
# Behind a load balancer: its addresses/CIDRs, so clients can't fake their IP.
# THEIRSIDE_TRUST_PROXY=10.0.0.0/24
# Sign-in through an identity proxy (header) or an ALB with OIDC (alb):
# THEIRSIDE_AUTH_PROXY=header
# THEIRSIDE_AUTH_PROXY_TRUSTED_IPS=10.0.12.0/24
# THEIRSIDE_AUTH_PROXY_HEADER=X-Forwarded-Email
# THEIRSIDE_AUTH_PROXY_ALB_ARN=arn:aws:elasticloadbalancing:<region>:<account>:loadbalancer/app/<name>/<id>
# THEIRSIDE_AUTH_PROXY_AUTO_CREATE=false

# --- email: alerts, invites, password resets (optional) ------------------
# Either one connection URL...
#   smtp://user:pass@host:587   plain connection upgraded with STARTTLS
#   smtps://user:pass@host:465  TLS from the start
# URL-encode special characters in the password (e.g. @ -> %40, / -> %2F).
# ...or the separate settings below. TLS is required by default whenever
# credentials are set (THEIRSIDE_SMTP_REQUIRE_TLS=false to allow plain text).
# THEIRSIDE_SMTP_URL=
# THEIRSIDE_SMTP_HOST=
# THEIRSIDE_SMTP_PORT=587
# THEIRSIDE_SMTP_SECURE=false
# THEIRSIDE_SMTP_REQUIRE_TLS=true
# THEIRSIDE_SMTP_USER=
# THEIRSIDE_SMTP_PASS=
# Sender address; many providers only accept a verified sender/domain.
# THEIRSIDE_SMTP_FROM=alerts@example.com

# Gmail / Google Workspace: needs 2-step verification and an App Password
# (Google account -> Security -> App passwords); the normal password is refused.
#   THEIRSIDE_SMTP_URL=smtp://you%40example.com:<app-password>@smtp.gmail.com:587
#   THEIRSIDE_SMTP_FROM=you@example.com

# Amazon SES: use SES SMTP credentials (SES console -> SMTP settings), not IAM
# access keys; the From address or domain must be verified in SES.
#   THEIRSIDE_SMTP_URL=smtp://<ses-smtp-username>:<ses-smtp-password>@email-smtp.eu-west-1.amazonaws.com:587
#   THEIRSIDE_SMTP_FROM=alerts@example.com

# Postmark: the Server API token is both username and password; the From
# address needs a confirmed sender signature or domain.
#   THEIRSIDE_SMTP_URL=smtp://<server-token>:<server-token>@smtp.postmarkapp.com:587
#   THEIRSIDE_SMTP_FROM=alerts@example.com

# Slack and webhook channels need no collector settings: add them in the
# dashboard under Settings -> Alert channels, then "Send test alert".

# --- auto-discovery (optional) -------------------------------------------
# Extra catalog entries (name, category, domains) on top of the bundled catalog.
# The compose file defaults to the demo's file, which only matches the reserved .test TLD.
# THEIRSIDE_CATALOG_OVERRIDE=

# --- licence (optional) --------------------------------------------------
# THEIRSIDE_LICENSE_KEY=

# --- tuning (defaults shown) ---------------------------------------------
# THEIRSIDE_RAW_RETENTION_DAYS=30
# THEIRSIDE_ROLLUP_RETENTION_DAYS=90
# THEIRSIDE_STATUS_CACHE_SECONDS=30
# LOG_LEVEL=info
